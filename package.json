{
  "name": "lemon-juice",
  "version": "0.11.0",
  "private": true,
  "description": "Firefox extension that finds SOME hidden text and prompt-injection payloads on web pages before you hand them to an AI.",
  "license": "GPL-3.0",
  "packageManager": "pnpm@11.5.0",
  "scripts": {
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "node --test",
    "bench": "node bench/run.js",
    "bench:garak": "node bench/garak.js",
    "bench:paraphrase": "node bench/paraphrase.js",
    "package": "node scripts/package-firefox.js && web-ext build --source-dir dist/firefox --artifacts-dir dist --filename lemon-juice.zip --overwrite-dest",
    "package:chrome": "node scripts/package-chrome.js",
    "lint:extension": "web-ext lint --source-dir dist/firefox",
    "check:packages": "node scripts/check-packages.js",
    "release": "node scripts/release.js",
    "test:e2e": "playwright test",
    "scan:opengrep": "opengrep scan --config=.opengrep/lemon-juice.yaml --no-rewrite-rule-ids ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "web-ext": "10.8.0"
  }
}
